<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C26"
    android:keepScreenOn="true">

    <!-- مشغل الفيديو في الخلفية -->
    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- واجهة الانتظار والشاشة الرئيسية -->
    <LinearLayout
        android:id="@+id/layout_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="VERTICAL"
        android:padding="24dp">

        <!-- الترحيب بأبو عزت -->
        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="أهلاً بك يا أبو عزت"
            android:textColor="#FFD700"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- صورة ست الحبايب بالطول واضحة ومتناسقة -->
        <ImageView
            android:id="@+id/iv_memorial"
            android:layout_width="190dp"
            android:layout_height="270dp"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/grandma" />

        <!-- الذكر الطيب -->
        <TextView
            android:id="@+id/tv_zekr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ، سُبْحَانَ اللَّهِ الْعَظِيمِ"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- صندوق حالة السيرفر والـ IP الرمادي الشفاف -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#333842"
            android:gravity="center"
            android:minWidth="440dp"
            android:orientation="VERTICAL"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حالة السيرفر: جاهز للتشغيل ✓"
                android:textColor="#00E676"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="عنوان الاتصال: http://0.0.0.0:8081"
                android:textColor="#00B0FF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
